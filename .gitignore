.env
.env.*
*.pem
*.p12
*.jks
*.keystore
*.key
key.properties
keystore.properties
secrets.properties
**/keys/
serviceAccount*.json
**/google-services.json
**/GoogleService-Info.plist

# Spring config with credentials
**/application.yml
**/application.yaml
**/application-*.yml
**/application-*.yaml
**/application.example.yml
**/application.example.yaml
**/application*.properties
!**/application*.properties.template

